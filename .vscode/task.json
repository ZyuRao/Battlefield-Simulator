{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure (CMake, Ninja)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", ".",
        "-B", "build",
        "-G", "Ninja",                
        "-DCMAKE_BUILD_TYPE=Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build (CMake, Ninja)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build", "build",          
        "--config", "Debug",
        "-j"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "dependsOn": ["Configure (CMake, Ninja)"]
    }
  ]
}
